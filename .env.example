# Zkopírujte na NAS jako .env vedle docker-compose.yml
#
# Veřejný image (lowercase):
#   ghcr.io/pjanecekatlangmaster/podkladarna:latest

GHCR_OWNER=pjanecekatlangmaster

# Volitelně – jen pro privátní GHCR balíček (repo i image jsou veřejné)
# GHCR_USER=pjanecekatlangmaster
# GHCR_TOKEN=ghp_xxxxxxxx

# Volitelně rychlejší čekání na Actions (jinak veřejné API bez tokenu, poll 45 s)
# GH_TOKEN=ghp_xxxxxxxx
# GITHUB_REPO=pjanecekatlangmaster/podkladarna
# GITHUB_BRANCH=master

# --- SMTP (privátní joby – odkaz ke stažení e-mailem) ---
# Microsoft 365 protection relay (často IP allowlist, USER/PASSWORD prázdné):
SMTP_HOST=datais-cz.mail.protection.outlook.com
SMTP_PORT=25
SMTP_ENCRYPTION=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=podkladarna@datais.cz
SMTP_FROM_NAME=OB podklady

# Absolutní URL instance bez koncového / (odkazy v e-mailu)
# PUBLIC_BASE_URL=https://podkladarna.example

# Platnost privátního odkazu / mazání artefaktů (hodiny od založení jobu)
# PRIVATE_JOB_RETENTION_HOURS=48

# Volitelně – georef PNG přes Mapper CLI (fork s --cli export, ne stock 0.9.6)
# PODKLADARNA_MAPPER=/opt/oomapper/bin/Mapper
# PODKLADARNA_MAPPER_EXPORT="{mapper} --cli export --full-map -i {omap} -o {png} --dpi {dpi}"
# QT_QPA_PLATFORM=offscreen
# PODKLADARNA_OOM_EXPORT_DPI=600
