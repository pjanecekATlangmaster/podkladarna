# Zkopírujte na NAS jako .env vedle docker-compose.yml
#
# Veřejný image (lowercase):
#   ghcr.io/pjanecekatlangmaster/podkladarna:latest

GHCR_OWNER=pjanecekatlangmaster

# Volitelně – jen pro privátní GHCR balíček (repo i image jsou veřejné)
# GHCR_USER=pjanecekatlangmaster
# GHCR_TOKEN=ghp_xxxxxxxx

# Volitelně rychlejší čekání na Actions (jinak veřejné API bez tokenu, poll 45 s)
# GH_TOKEN=ghp_xxxxxxxx
# GITHUB_REPO=pjanecekatlangmaster/podkladarna
# GITHUB_BRANCH=master

# --- SMTP (privátní joby – odkaz ke stažení e-mailem) ---
# Microsoft 365 protection relay (často IP allowlist, USER/PASSWORD prázdné):
SMTP_HOST=datais-cz.mail.protection.outlook.com
SMTP_PORT=25
SMTP_ENCRYPTION=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=podkladarna@datais.cz
SMTP_FROM_NAME=OB podklady

# Absolutní URL instance bez koncového / (odkazy v e-mailu)
# PUBLIC_BASE_URL=https://podkladarna.example
# Lokalizace (app/i18n.py): domény a jejich výchozí jazyk, jazyky v přepínači.
# SITES=podkladarna.kibos.link=cs,nova-domena.eu=en
# LANGS=cs,en
# DEFAULT_LANG=cs

# Platnost privátního odkazu / mazání artefaktů (hodiny od založení jobu)
# PRIVATE_JOB_RETENTION_HOURS=48

# Zpětná vazba z webu (kontakt + komentář u hotové mapy) → e-mail Petrovi
# FEEDBACK_TO=janecek@datais.cz
# OWNER_EMAIL=janecek@datais.cz
# MAX_FEEDBACK_PER_IP_HOUR=5

# --- API klient (Stavitel) ---
# Sdílený klíč pro hlavičku X-Api-Key (soukromý job bez e-mailu, download_token v odpovědi).
# Prázdné = vypnuto. Skutečný klíč jen do .env na NAS, nikdy do gitu.
# Vygenerujte např.: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_CLIENT_KEY=
# API_KEY_MAX_ACTIVE_JOBS=3
# API_KEY_MAX_JOBS_HOUR=20

# --- Mapper CLI (georef GeoTIFF @ 300 DPI + .ocd OCD12 do ZIPu) ---
# Docker image tyto hodnoty už nastavuje (multi-stage build PR #2523).
# Na NAS je obvykle netřeba přepisovat. Lokální Windows tip bez CLI:
# nechte prázdné / neexportujte → Pillow georef fallback @ 300 DPI-eq;
# .ocd do ZIPu se přeskočí (zůstane .omap).
# PODKLADARNA_MAPPER=/opt/mapper/bin/Mapper
# PODKLADARNA_MAPPER_EXPORT="{mapper}" --cli export --full-map -i "{omap}" -o "{png}" --dpi {dpi}
# PODKLADARNA_MAPPER_CONVERT="{mapper}" --cli convert -i "{omap}" -o "{ocd}" --output-format OCD12
# PODKLADARNA_MAPPER_TIMEOUT=600
# QT_QPA_PLATFORM=offscreen

# --- LiDAR ---
# Souběžné PDAL ořezy SM5 listů (proudové, paměť zanedbatelná). Default
# podle CPU kontejneru: jádra − 1, aspoň 2, nejvýš 8 (R1600 2C/4T → 3);
# respektuje docker cpus/cpuset. 1 = sériově jako před 2.3.0.
# PODKLADARNA_LIDAR_WORKERS=3

# --- A/B provoz (docker-compose.nas-ab.yml) ---
# Tag image pro A (stabilní) a B (test); rollback A: IMAGE_TAG_A=<sha tag>
# IMAGE_TAG_A=stable
# Paměťový strop kontejnerů na tomto stroji (A i B, výchozí 12g; pve1 má víc RAM); po změně ./update-nas-ab.sh stable (up -d)
# MEM_LIMIT_A=12g
# IMAGE_TAG_B=latest
# Adresy instancí (odkazy v e-mailech, banner v testovací verzi)
# PUBLIC_BASE_URL=https://podkladarna.kibos.link
# TEST_PUBLIC_BASE_URL=https://pt.kibos.link
# STABLE_URL=https://podkladarna.kibos.link
