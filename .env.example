# Zkopírujte na NAS jako .env vedle docker-compose.yml
#
# GHCR image je vždy lowercase (viz Actions log):
#   ghcr.io/pjanecekatlangmaster/podkladarna:latest

GHCR_OWNER=pjanecekatlangmaster
GHCR_USER=pjanecekatlangmaster

# Povinné – privátní repozitář / GHCR balíček (PAT s read:packages)
GHCR_TOKEN=ghp_xxxxxxxx
